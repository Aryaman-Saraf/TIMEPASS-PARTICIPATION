<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Candor AI - Enterprise Portal & Technical Pre-Flight</title>
  <link rel="stylesheet" href="styles.css">
  <style>
    /* Portal Landing & Persona Selector */
    .portal-container {
      max-width: 960px;
      margin: 2rem auto;
      padding: 0 1.5rem;
    }
    .persona-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      margin-top: 2rem;
    }
    @media (max-width: 768px) {
      .persona-grid {
        grid-template-columns: 1fr;
      }
    }
    .persona-card {
      background: var(--surface-dark);
      border: 1px solid var(--border-dark);
      border-radius: var(--radius-lg);
      padding: 2rem;
      cursor: pointer;
      transition: all 0.25s ease;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .persona-card:hover {
      border-color: var(--primary);
      transform: translateY(-3px);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.4), 0 0 20px rgba(59, 130, 246, 0.15);
    }
    .persona-card.active {
      border-color: var(--primary);
      background: linear-gradient(180deg, rgba(30, 58, 138, 0.15) 0%, var(--surface-dark) 100%);
    }
    .persona-icon {
      width: 52px;
      height: 52px;
      border-radius: var(--radius-md);
      display: grid;
      place-items: center;
      font-size: 1.5rem;
      margin-bottom: 1.25rem;
    }
    .icon-recruiter {
      background: rgba(59, 130, 246, 0.15);
      border: 1px solid rgba(59, 130, 246, 0.3);
      color: #60a5fa;
    }
    .icon-candidate {
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: #34d399;
    }
    .persona-title {
      font-size: 1.25rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 0.5rem;
    }
    .persona-desc {
      color: var(--text-muted);
      font-size: 0.875rem;
      line-height: 1.5;
      margin-bottom: 1.5rem;
      flex: 1;
    }

    /* Candidate Roster Pills */
    .candidate-roster {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-top: 1rem;
    }
    .candidate-card-btn {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border-dark);
      border-radius: var(--radius-md);
      padding: 0.875rem 1rem;
      color: var(--text-main);
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      text-align: left;
      transition: all 0.2s;
    }
    .candidate-card-btn:hover {
      border-color: var(--primary);
      background: rgba(59, 130, 246, 0.1);
    }

    /* Read-Only Information Cards */
    .readonly-banner {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid var(--border-dark);
      border-radius: var(--radius-md);
      padding: 1rem 1.25rem;
      margin-bottom: 1.25rem;
      text-align: left;
    }
    .readonly-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
    }
    .readonly-item {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .readonly-label {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
    }
    .readonly-value {
      font-size: 0.875rem;
      font-weight: 600;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .lock-pill {
      font-size: 0.6875rem;
      padding: 0.125rem 0.5rem;
      border-radius: 99px;
      background: rgba(59, 130, 246, 0.15);
      border: 1px solid rgba(59, 130, 246, 0.3);
      color: #93c5fd;
      font-weight: 500;
    }
    .pii-pill {
      font-size: 0.6875rem;
      padding: 0.125rem 0.5rem;
      border-radius: 99px;
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: #6ee7b7;
      font-weight: 500;
    }

    /* Waitline indicator */
    .waitline-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.25);
      border-radius: var(--radius-md);
      padding: 0.625rem 1rem;
      margin-bottom: 1.25rem;
      font-size: 0.8125rem;
      color: #a7f3d0;
    }

    /* Pre-Flight Video & Audio Styles */
    .mic-meter-wrap {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-top: 0.75rem;
      margin-bottom: 1rem;
      font-size: 0.75rem;
      color: var(--text-muted);
    }
    .mic-meter-bar {
      flex: 1;
      height: 6px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 99px;
      overflow: hidden;
    }
    .mic-meter-fill {
      height: 100%;
      width: 0%;
      background: var(--success);
      transition: width 0.08s ease;
    }
  </style>
</head>
<body>

  <!-- Top Navbar -->
  <nav class="navbar flex-between">
    <a href="index.html" class="brand-logo">
      <div class="brand-icon">C</div>
      <span>Candor AI</span>
    </a>
    <div class="flex gap-4">
      <div id="nav-user-pill" class="flex gap-2" style="display: none;">
        <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--primary); display: grid; place-items: center; font-weight: 700; font-size: 0.8125rem; color: #fff;" id="avatar-initial">S</div>
        <div style="font-size: 0.8125rem;">
          <div style="font-weight: 600;" id="user-display-name">Sarah Jenkins</div>
          <div style="color: var(--text-muted); font-size: 0.75rem;" id="user-role-badge">Candidate</div>
        </div>
        <button class="btn btn-outline" style="padding: 0.25rem 0.5rem; font-size: 0.75rem; margin-left: 0.5rem;" onclick="switchUser()">Switch User</button>
      </div>

      <a href="report.html" class="btn btn-outline" style="padding: 0.375rem 0.875rem; text-decoration: none; font-size: 0.8125rem;">
        📊 Recruiter Portal
      </a>
      <a href="test-integrity.html" class="btn btn-outline" style="padding: 0.375rem 0.875rem; text-decoration: none; font-size: 0.8125rem;">
        🛡️ Vision Sandbox
      </a>
    </div>
  </nav>

  <!-- VIEW 1: Main Portal Gateway & Role Login -->
  <div id="view-portal" class="portal-container">
    <div style="text-align: center; margin-top: 1.5rem; margin-bottom: 2rem;">
      <div class="chip chip-success" style="margin-bottom: 0.75rem; display: inline-flex;">
        <span>🔒 Zero Bias · On-Device Verification</span>
      </div>
      <h1 style="font-size: 2.25rem; font-weight: 700; margin-bottom: 0.5rem; color: #fff;">
        Candor Interview Gateway
      </h1>
      <p style="color: var(--text-muted); font-size: 1rem; max-width: 560px; margin: auto;">
        Welcome to Candor AI. Please select your portal access to proceed with your scheduled screening or candidate management.
      </p>
    </div>

    <div class="persona-grid">
      <!-- Persona 1: Candidate / Interviewee -->
      <div class="persona-card" onclick="selectPersona('candidate')">
        <div class="persona-icon icon-candidate">🎙️</div>
        <h2 class="persona-title">Candidate / Interviewee</h2>
        <p class="persona-desc">
          Join your scheduled voice interview. Complete pre-flight audio/video calibration and begin your adaptive technical screening.
        </p>

        <div style="border-top: 1px solid var(--border-dark); padding-top: 1rem;">
          <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase;">
            Select Scheduled Invitation:
          </span>
          <div class="candidate-roster">
            <button class="candidate-card-btn" onclick="loginCandidate('frontend', event)">
              <div>
                <strong style="color: #fff;">Sarah Jenkins</strong>
                <div style="font-size: 0.75rem; color: var(--text-muted);">Senior Frontend Engineer · Platform Team</div>
              </div>
              <span class="chip chip-success" style="font-size: 0.6875rem;">Ready ↗</span>
            </button>
            <button class="candidate-card-btn" onclick="loginCandidate('backend', event)">
              <div>
                <strong style="color: #fff;">Alex Chen</strong>
                <div style="font-size: 0.75rem; color: var(--text-muted);">Senior Backend Engineer · Distributed Systems</div>
              </div>
              <span class="chip chip-success" style="font-size: 0.6875rem;">Ready ↗</span>
            </button>
            <button class="candidate-card-btn" onclick="loginCandidate('fullstack', event)">
              <div>
                <strong style="color: #fff;">Jordan Lee</strong>
                <div style="font-size: 0.75rem; color: var(--text-muted);">Full Stack AI Engineer · Conversational Apps</div>
              </div>
              <span class="chip chip-success" style="font-size: 0.6875rem;">Ready ↗</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Persona 2: Hiring Manager / Recruiter -->
      <div class="persona-card" onclick="selectPersona('recruiter')">
        <div class="persona-icon icon-recruiter">👔</div>
        <h2 class="persona-title">Hiring Manager / Recruiter</h2>
        <p class="persona-desc">
          Review completed candidate Evidence Dossiers, inspect BARS rubric scores, calibrate job criteria, and manage candidate invitations.
        </p>

        <div style="margin-top: auto; border-top: 1px solid var(--border-dark); padding-top: 1.25rem;">
          <a href="report.html" class="btn btn-primary" style="width: 100%; text-decoration: none; padding: 0.875rem; font-size: 0.9375rem; display: flex; justify-content: center; align-items: center; gap: 0.5rem;">
            <span>Open Recruiter Dossier Dashboard</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- VIEW 2: Candidate Waiting Room & Technical Pre-Flight (Locked by Hiring Manager) -->
  <div id="view-candidate-setup" class="setup-overlay" style="display: none; padding: 2rem 1rem; overflow-y: auto;">
    <div class="setup-card" style="max-width: 720px; width: 100%; margin: auto;">
      
      <!-- Top Status & Waiting Line -->
      <div class="waitline-bar">
        <div class="flex gap-2">
          <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #10b981; animation: pulse 1.5s infinite;"></span>
          <strong>Waiting Line Status:</strong> Next in Line (#1) · AI Interviewer Ava Ready
        </div>
        <button class="btn btn-outline" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" onclick="switchUser()">Switch User</button>
      </div>

      <div style="text-align: center; margin-bottom: 1.25rem;">
        <h1 style="font-size: 1.625rem; font-weight: 700; margin-bottom: 0.25rem;">Technical Pre-Flight Check</h1>
        <p style="color: var(--text-muted); font-size: 0.875rem;">Calibrate your audio and video before entering the live interview room</p>
      </div>

      <!-- READ-ONLY Candidate & Job Spec Banner (Set by Hiring Manager) -->
      <div class="readonly-banner">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
          <span style="font-size: 0.75rem; font-weight: 700; color: #93c5fd; text-transform: uppercase; letter-spacing: 0.5px;">
            📋 Interview Specification (Configured by Hiring Manager)
          </span>
          <span class="lock-pill">🔒 Hiring Manager Locked</span>
        </div>

        <div class="readonly-grid">
          <div class="readonly-item">
            <span class="readonly-label">Candidate Name</span>
            <div class="readonly-value">
              <span id="spec-candidate-name">Sarah Jenkins</span>
            </div>
          </div>
          <div class="readonly-item">
            <span class="readonly-label">Assigned Target Role</span>
            <div class="readonly-value">
              <span id="spec-target-role">Senior Frontend Engineer</span>
            </div>
          </div>
          <div class="readonly-item">
            <span class="readonly-label">Interview Mode</span>
            <div class="readonly-value">
              <span>Adaptive STAR Probing</span>
            </div>
          </div>
          <div class="readonly-item">
            <span class="readonly-label">Target Questions</span>
            <div class="readonly-value">
              <span id="spec-question-count">4 Questions (~12 min)</span>
            </div>
          </div>
        </div>

        <!-- Collapsible Job Description & Resume (Read-Only) -->
        <details style="margin-top: 0.875rem; border-top: 1px solid var(--border-dark); padding-top: 0.625rem;">
          <summary style="font-size: 0.75rem; color: var(--primary); cursor: pointer; user-select: none;">
            🔍 View Extracted Job Description & Pre-Uploaded Resume
          </summary>
          <div style="margin-top: 0.75rem; display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.8125rem;">
            <div>
              <div style="font-weight: 600; color: #fff; margin-bottom: 0.25rem;">Job Description (Hiring Manager):</div>
              <div id="spec-job-desc" style="color: var(--text-muted); background: rgba(0,0,0,0.3); padding: 0.625rem; border-radius: var(--radius-sm); line-height: 1.45;"></div>
            </div>
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
                <span style="font-weight: 600; color: #fff;">Candidate Resume on File:</span>
                <span class="pii-pill">🛡️ PII Redacted & Anonymized</span>
              </div>
              <div id="spec-resume-text" style="color: var(--text-muted); background: rgba(0,0,0,0.3); padding: 0.625rem; border-radius: var(--radius-sm); line-height: 1.45;"></div>
              <div style="margin-top: 0.625rem; display: flex; align-items: center; gap: 0.75rem;">
                <label class="btn btn-outline" style="font-size: 0.75rem; padding: 0.25rem 0.625rem; cursor: pointer; display: inline-flex; align-items: center; gap: 0.375rem;">
                  <span>📎 Upload New Resume (.pdf / .txt)</span>
                  <input type="file" id="resume-file-input" accept=".txt,.pdf,.docx,.md" style="display: none;" onchange="handleResumeFileUpload(event)">
                </label>
                <span id="resume-upload-status" style="font-size: 0.75rem; color: #a7f3d0;"></span>
              </div>
            </div>
          </div>
        </details>
      </div>

      <!-- Video Preview Frame -->
      <div class="video-preview-box">
        <video id="preview-video" autoplay muted playsinline style="transform: scaleX(-1);"></video>
        <div id="ready-chip" class="chip chip-success" style="position: absolute; top: 0.75rem; right: 0.75rem; z-index: 10;">
          <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--success); display: inline-block;"></span>
          <span id="ready-status-text">Devices Verified</span>
        </div>

        <!-- Device Controls Selector Bar -->
        <div class="video-controls-bar">
          <select id="cam-select" class="select-control">
            <option>📹 Camera: Detecting…</option>
          </select>
          <select id="mic-select" class="select-control">
            <option>🎙️ Microphone: Detecting…</option>
          </select>
          <select id="spk-select" class="select-control">
            <option>🔊 Speakers: Default System Output</option>
          </select>
        </div>
      </div>

      <!-- Live Mic Volume Meter -->
      <div class="mic-meter-wrap">
        <span>Mic Activity:</span>
        <div class="mic-meter-bar">
          <div id="mic-fill" class="mic-meter-fill"></div>
        </div>
        <span id="mic-db-text" style="font-family: monospace;">0%</span>
      </div>

      <!-- Status Indicator Pills -->
      <div class="flex" style="justify-content: center; gap: 0.75rem; margin-bottom: 1.25rem; flex-wrap: wrap;">
        <div id="cam-chip" class="chip chip-success">
          <span>✓</span> <span>Camera Active</span>
        </div>
        <div id="mic-chip" class="chip chip-success">
          <span>✓</span> <span>Microphone Connected</span>
        </div>
        <div id="stt-chip" class="chip chip-success">
          <span>✓</span> <span>Speech AI Ready</span>
        </div>
      </div>

      <!-- Audio Output Test & Action Buttons -->
      <div class="flex-col gap-3" style="align-items: center;">
        <button type="button" class="btn btn-outline" onclick="testAudioFeedback()" style="font-size: 0.8125rem;">
          🔊 Test Audio Speakers & Voice Synthesis
        </button>
        <button type="button" id="start-btn" onclick="startCandidateInterview()" class="btn btn-primary" style="width: 100%; max-width: 360px; padding: 0.875rem 1.5rem; font-size: 1rem; font-weight: 600;">
          Enter Interview Room ↗
        </button>
      </div>

    </div>
  </div>

  <script>
    // Pre-Configured Roster (Set by Hiring Manager)
    const CANDIDATES = {
      frontend: {
        id: "cand-001",
        name: "Sarah Jenkins",
        role: "Senior Frontend Engineer",
        department: "Platform Engineering",
        questionCount: 4,
        jobDesc: "Senior Frontend Engineer specializing in React 18/19, TypeScript, Core Web Vitals optimization, and real-time state management. Experience with high-traffic enterprise design systems and WebSockets required.",
        resume: "Sarah Jenkins - 6 years frontend engineering at FinTech Co. Led migration to Next.js 14, reduced LCP from 3.8s to 1.4s via lazy-loading and code splitting. Authored enterprise component library used across 12 product teams."
      },
      backend: {
        id: "cand-002",
        name: "Alex Chen",
        role: "Senior Backend Engineer",
        department: "Infrastructure & Distributed Systems",
        questionCount: 4,
        jobDesc: "Distributed systems engineer experienced in high-throughput Node.js microservices, Postgres sharding, Redis caching, and incident RCA. Must demonstrate strong concurrency control and API design.",
        resume: "Alex Chen - 7 years backend engineering at ScaleStream. Designed event-driven payment reconciliation pipeline processing 15k TPS with zero data loss. Implemented distributed Redis locks and multi-region failover."
      },
      fullstack: {
        id: "cand-003",
        name: "Jordan Lee",
        role: "Full Stack AI Engineer",
        department: "Conversational Applications",
        questionCount: 4,
        jobDesc: "Full Stack Engineer to build AI-powered conversational tools. Deep proficiency in modern JavaScript, REST/WebSocket APIs, responsive UI design, and cloud deployments.",
        resume: "Jordan Lee - 4 years full stack experience at HealthAI. Built real-time clinician dashboard using WebRTC and Node.js. Optimized database query performance and implemented OAuth2 authentication."
      }
    };

    let activeCandidate = CANDIDATES.frontend;
    let audioCtx = null;
    let micStream = null;
    let micAnalyser = null;
    let micAnimId = null;

    // Automated Resume File Upload & Parsing Handler
    async function handleResumeFileUpload(event) {
      const file = event.target.files[0];
      if (!file) return;
      const statusEl = document.getElementById('resume-upload-status');
      if (statusEl) statusEl.textContent = 'Uploading & parsing resume…';

      const reader = new FileReader();
      reader.onload = async () => {
        try {
          const base64 = reader.result.split(',')[1];
          const res = await fetch('/api/candidate/resume-upload', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              candidateId: activeCandidate.id,
              filename: file.name,
              base64: base64
            })
          });
          const data = await res.json();
          if (data.ok) {
            if (statusEl) statusEl.textContent = `✓ Extracted & Redacted (${data.wordCount} words)`;
            const resumeEl = document.getElementById('spec-resume-text');
            if (resumeEl) resumeEl.textContent = data.preview + '…';
            activeCandidate.resume = data.preview;
          } else {
            if (statusEl) statusEl.textContent = 'Upload failed: ' + (data.error || 'Server error');
          }
        } catch (e) {
          if (statusEl) statusEl.textContent = 'Error parsing file: ' + e.message;
        }
      };
      reader.readAsDataURL(file);
    }

    function selectPersona(type) {
      if (type === 'recruiter') {
        window.location.href = 'report.html';
      }
    }

    function loginCandidate(key, event) {
      if (event) event.stopPropagation();
      activeCandidate = CANDIDATES[key] || CANDIDATES.frontend;
      showCandidateSetup();
    }

    function switchUser() {
      if (micAnimId) cancelAnimationFrame(micAnimId);
      if (micStream) micStream.getTracks().forEach(t => t.stop());
      document.getElementById('view-candidate-setup').style.display = 'none';
      document.getElementById('view-portal').style.display = 'block';
      document.getElementById('nav-user-pill').style.display = 'none';
    }

    function showCandidateSetup() {
      document.getElementById('view-portal').style.display = 'none';
      document.getElementById('view-candidate-setup').style.display = 'flex';

      // Update Nav User Pill
      document.getElementById('nav-user-pill').style.display = 'flex';
      document.getElementById('user-display-name').textContent = activeCandidate.name;
      document.getElementById('avatar-initial').textContent = activeCandidate.name.charAt(0);
      document.getElementById('user-role-badge').textContent = activeCandidate.role;

      // Update Read-Only Spec Banner
      document.getElementById('spec-candidate-name').textContent = activeCandidate.name;
      document.getElementById('spec-target-role').textContent = activeCandidate.role;
      document.getElementById('spec-job-desc').textContent = activeCandidate.jobDesc;
      document.getElementById('spec-resume-text').textContent = activeCandidate.resume;
      document.getElementById('spec-question-count').textContent = `${activeCandidate.questionCount} Questions (~12 min)`;

      initPreflight();
    }

    // Audio Chime Synthesizer
    function playChime(freq = 523.25, type = 'sine', duration = 0.2) {
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      } catch (e) {
        console.warn('Audio playChime notice:', e);
      }
    }

    // Camera & Mic Calibration
    async function initPreflight() {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
        document.getElementById('preview-video').srcObject = stream;
        micStream = stream;

        // Populate device labels
        const devices = await navigator.mediaDevices.enumerateDevices();
        const camSelect = document.getElementById('cam-select');
        const micSelect = document.getElementById('mic-select');
        camSelect.innerHTML = '';
        micSelect.innerHTML = '';

        devices.forEach(d => {
          const opt = document.createElement('option');
          opt.value = d.deviceId;
          if (d.kind === 'videoinput') {
            opt.textContent = `📹 ${d.label || 'Web Camera'}`;
            camSelect.appendChild(opt);
          } else if (d.kind === 'audioinput') {
            opt.textContent = `🎙️ ${d.label || 'Microphone'}`;
            micSelect.appendChild(opt);
          }
        });

        if (!camSelect.options.length) camSelect.innerHTML = '<option>📹 Camera: Default Stream</option>';
        if (!micSelect.options.length) micSelect.innerHTML = '<option>🎙️ Microphone: Default Stream</option>';

        // Real-time Mic Activity Meter
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        micAnalyser = audioCtx.createAnalyser();
        micAnalyser.fftSize = 64;
        const source = audioCtx.createMediaStreamSource(stream);
        source.connect(micAnalyser);
        const dataArray = new Uint8Array(micAnalyser.frequencyBinCount);

        const micFill = document.getElementById('mic-fill');
        const micDbText = document.getElementById('mic-db-text');

        function updateMicMeter() {
          micAnalyser.getByteFrequencyData(dataArray);
          let sum = 0;
          for (let i = 0; i < dataArray.length; i++) sum += dataArray[i];
          const avg = sum / dataArray.length;
          const pct = Math.min(100, Math.round((avg / 128) * 100));
          micFill.style.width = pct + '%';
          micDbText.textContent = pct + '%';
          micAnimId = requestAnimationFrame(updateMicMeter);
        }
        updateMicMeter();

        playChime(659.25, 'sine', 0.25);
      } catch (err) {
        console.warn('Pre-flight media capture notice:', err);
        const camChip = document.getElementById('cam-chip');
        camChip.className = 'chip chip-danger';
        camChip.innerHTML = '<span>⚠️</span> <span>Camera/Mic Inactive (Text Mode)</span>';
        document.getElementById('ready-status-text').textContent = 'Manual Text Mode';
        document.getElementById('ready-chip').className = 'chip chip-danger';
      }

      // Check speech recognition
      const hasSpeech = ('SpeechRecognition' in window) || ('webkitSpeechRecognition' in window);
      const sttChip = document.getElementById('stt-chip');
      if (!hasSpeech) {
        sttChip.className = 'chip chip-warn';
        sttChip.innerHTML = '<span>ℹ️</span> <span>Speech AI: Manual Keyboard</span>';
      }
    }

    function testAudioFeedback() {
      playChime(880, 'triangle', 0.3);
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const utt = new SpeechSynthesisUtterance("Audio output is active and verified. Candor AI voice synthesis is ready.");
        utt.rate = 1.05;
        window.speechSynthesis.speak(utt);
      }
    }

    // Start Candidate Interview via POST /api/start-interview using Hiring Manager's pre-configured spec
    async function startCandidateInterview() {
      const startBtn = document.getElementById('start-btn');
      startBtn.disabled = true;
      startBtn.innerHTML = '<span>⏳ Starting Session & Tailoring Plan…</span>';
      playChime(783.99, 'sine', 0.3);

      try {
        const res = await fetch('/api/start-interview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            candidateName: activeCandidate.name,
            role: activeCandidate.role,
            jobDescription: activeCandidate.jobDesc,
            resumeText: activeCandidate.resume,
            questionCount: activeCandidate.questionCount
          })
        });

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.error || `HTTP ${res.status}`);
        }

        const session = await res.json();
        
        // Clean up preview audio animation before navigation
        if (micAnimId) cancelAnimationFrame(micAnimId);
        if (micStream) micStream.getTracks().forEach(t => t.stop());

        // Redirect to live interview room with created session ID
        window.location.href = `room.html?id=${encodeURIComponent(session.id)}`;
      } catch (err) {
        console.error('Failed to start interview:', err);
        alert(`Could not start interview session: ${err.message}. Please verify the server is running.`);
        startBtn.disabled = false;
        startBtn.innerHTML = 'Enter Interview Room ↗';
      }
    }
  </script>
</body>
</html>
