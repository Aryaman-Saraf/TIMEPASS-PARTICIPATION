# Copy to .env (never commit .env). Each teammate uses their OWN Groq key.
GROQ_API_KEY=
# Optional fallback provider (one key for the whole team is enough)
GEMINI_API_KEY=
# Optional model overrides (defaults shown)
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_SMART_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-flash-lite-latest
PORT=3000
